# PostgreSQL connection string (SQLAlchemy + psycopg3 driver)
# Local dev expects the +psycopg prefix shown below.
# On a managed host (Railway/Render/Supabase) you can paste their plain
# postgres:// or postgresql:// URL as-is, the app rewrites it to +psycopg.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gtmflow

# OpenAI, leave blank while USE_MOCK_AI=true
OPENAI_API_KEY=

# Slack incoming webhook, leave blank to use the mock pusher
SLACK_WEBHOOK_URL=

# When true (default), AI calls return canned mock responses
USE_MOCK_AI=true

# Phase 10: the real provider USE_MOCK_AI=false selects.
#   openai            -> OPENAI_API_KEY (default; paid per call)
#   qwen3-4b-lora-v1  -> the Phase 8 adapter behind an OpenAI-compatible
#                        inference server (see docs/engineering-log/phase10-integration-handoff.md)
AI_PROVIDER=openai
# e.g. http://localhost:8000/v1 (http only for a local/private host; otherwise https)
LORA_INFERENCE_BASE_URL=
# Optional bearer token for the inference server; never logged or returned
LORA_INFERENCE_API_KEY=
LORA_SERVED_MODEL=qwen3-4b-lora-v1
LORA_TIMEOUT_SECONDS=120
# With AI_PROVIDER=qwen3-4b-lora-v1: draft with the mock generator while the
# model server is offline (outputs are recorded as mock). Default false.
LORA_FALLBACK_TO_MOCK=false

# Lead-selection assistant (separate from the model that writes drafts).
# mock = fixed demonstration; openai = paid native tool calling, explicitly opt-in.
# USE_MOCK_AI=true overrides this too. No LoRA tool-calling capability is assumed.
AGENT_PROVIDER=mock
AGENT_MODEL=gpt-4o-mini

# Phase 12: operator sessions. Keep SESSION_COOKIE_SECURE=true everywhere
# except plain-http local development (set false explicitly there).
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Comma-separated browser origins allowed for credentialed CORS and login.
# Leave blank for local dev (defaults to localhost:3000 + 127.0.0.1:3000).
# In production set this to your deployed frontend URL, e.g.
# ALLOWED_ORIGINS=https://gtmflow-frontend.up.railway.app
ALLOWED_ORIGINS=

# Self-service sign-up (email + password, confirmed with an emailed 6-digit
# code) and one-click guest access. Both are off unless enabled here.
SELF_SIGNUP_ENABLED=false
# Role for verified sign-ups: operator (full use) or viewer (read-only).
SELF_SIGNUP_ROLE=operator
# Optional: only these email domains may sign up, e.g. example.com,acme.io
SIGNUP_ALLOWED_EMAIL_DOMAINS=
GUEST_ACCESS_ENABLED=false
# Guests can change data only when Slack is mocked, drafting is mock or
# self-hosted, and planning is mock. A paid planner also makes guests read-only.
GUEST_SESSION_HOURS=2

# Verification email. Leave SMTP_HOST empty for local development: the code
# is then printed in the API terminal and nothing is sent. Any SMTP provider
# works (STARTTLS on port 587 by default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=
