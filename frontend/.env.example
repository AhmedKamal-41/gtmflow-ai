# Base URL of the FastAPI backend.
# Local dev: http://localhost:8000
# Production: your deployed backend URL, e.g. https://gtmflow-backend.up.railway.app
#
# NOTE: this is a NEXT_PUBLIC_ variable, so Next.js bakes it in at BUILD time.
# It must be set in the host's variables BEFORE the build runs, changing it
# afterward has no effect until you trigger a rebuild.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
